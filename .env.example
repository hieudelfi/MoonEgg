# MoonEgg - environment variables. Names only, no values.
#
# Copy this file to .env and fill it in. .env is ignored by git (.gitignore:10).
#
# The anon key is a public key by design. Row level security protects the data,
# not the key. The service_role key is a different thing: it bypasses row level
# security, so it never goes in .env, in the repo, in a task record, or in a
# drop on the hub.

# Supabase project URL, for example https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / public key
VITE_SUPABASE_ANON_KEY=

# Public base URL of the Cloudflare R2 bucket that serves content packs
R2_PUBLIC_BASE=
